# Telegram API Credentials (my.telegram.org)
APP_ID=
API_HASH=

# Bot Token (BotFather)
TG_BOT_TOKEN=

# Database Settings
# Gunakan URL MongoDB (bisa Atlas atau Local)
DATABASE_URL=

# Channel Database (tempat file disimpan)
CHANNEL_ID=

# Admin User IDs (pisahkan dengan spasi jika lebih dari satu)
ADMINS=

# Username owner bot tanpa @
OWNER=

# Optional: Force Sub hardcoded (bisa diatur in-app)
FORCE_SUB_1=
FORCE_SUB_2=

# Pesan Bot (Optional, akan menggunakan default jika kosong)
# START_MESSAGE=
# FORCE_SUB_MESSAGE=
